HTTP_ADDR=127.0.0.1:3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=alumnee
MYSQL_PASSWORD=
MYSQL_DATABASE=alumnee
MYSQL_ROOT_PASSWORD=

# Local-only role testing. Keep disabled outside a loopback-bound development API.
DEMO_AUTH_ENABLED=false
DEMO_AUTH_PASSWORD=replace-with-a-random-local-only-password

# Optional public staging logins. Configure all four username/password pairs
# together; use unique usernames and passwords of at least 12 characters.
STAGING_AUTH_NON_VERIFIED_USERNAME=
STAGING_AUTH_NON_VERIFIED_PASSWORD=
STAGING_AUTH_VERIFIED_USERNAME=
STAGING_AUTH_VERIFIED_PASSWORD=
STAGING_AUTH_OFFICER_USERNAME=
STAGING_AUTH_OFFICER_PASSWORD=
STAGING_AUTH_ADMIN_USERNAME=
STAGING_AUTH_ADMIN_PASSWORD=

# OAuth login requires both providers' credentials and server-verified Turnstile CAPTCHA.
PUBLIC_BASE_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# Email OTP and initial admin bootstrap. Set these only in the private .env.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Staging walkthrough accounts: one shared password (min. 12 characters) for every
# account below. Leave the password empty to keep the accounts disabled (production).
# Set STAGING_SCENARIO_RESET=true for one restart to return them to a clean state.
STAGING_SCENARIO_PASSWORD=
STAGING_SCENARIO_RESET=false
# Admin
STAGING_SCENARIO_ADMIN_USERNAME=admin.uji
# Pengurus
STAGING_SCENARIO_OFFICER_1_USERNAME=pengurus.satu
STAGING_SCENARIO_OFFICER_2_USERNAME=pengurus.dua
# Member Non-verified, angkatan 2012
STAGING_SCENARIO_MEMBER_1_USERNAME=alumni.satu
STAGING_SCENARIO_MEMBER_2_USERNAME=alumni.dua
STAGING_SCENARIO_MEMBER_3_USERNAME=alumni.tiga
STAGING_SCENARIO_MEMBER_4_USERNAME=alumni.empat
STAGING_SCENARIO_MEMBER_5_USERNAME=alumni.lima
STAGING_SCENARIO_MEMBER_6_USERNAME=alumni.enam
STAGING_SCENARIO_MEMBER_7_USERNAME=alumni.tujuh

# Login attempts per minute per client IP (default 5). Raise on staging behind a shared proxy.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Optional: JSON list of kabupaten/kota codes (run scripts/fetch_regencies.py) used to
# validate the domestic city code. Without it only the code format is checked.
REGENCY_MASTER_PATH=

# Frontend values embedded in the static Caddy build.
NEXT_PUBLIC_DEMO_AUTH_ENABLED=false
